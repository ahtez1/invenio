# Copy this file to .env and fill in as needed.
# Leaving STRIPE_SECRET_KEY blank runs checkout in fully offline demo mode
# (orders are marked paid instantly, no signups required).

SECRET_KEY=change-me-to-something-random
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=http://localhost:3000

# Stripe (https://dashboard.stripe.com/test/apikeys) - leave blank for fake mode
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Email - leave blank to print emails to the console instead of sending them
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@inveni.local

# Database - leave both blank to use SQLite (no server needed).
# DATABASE_URL wins if set (e.g. postgres://user:pass@host:port/dbname -
# this is what a Railway/Heroku/Render Postgres plugin gives you).
DATABASE_URL=
DB_ENGINE=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# Production-only security toggles (enable once served over HTTPS)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
CSRF_TRUSTED_ORIGINS=
